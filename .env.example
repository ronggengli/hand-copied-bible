# 複製成 .env.local 後填入（.env.local 已被 .gitignore 排除，絕對不要 commit）
# 正式環境請在 Vercel 的 Environment Variables 設定，不是放這個檔案。

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# 後台通行碼：請用 12 字元以上的隨機字串
ADMIN_PIN=

# 寄信信箱：不一定要用 Gmail，任何有 SMTP 的信箱都可以（見 README「寄信信箱」）
MAIL_USER=your-church@gmail.com
# Gmail 要填「應用程式密碼」（16 碼），不是登入密碼
MAIL_PASS=
# 使用 Gmail 以外的信箱時，才需要填下面這些：
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false      # 埠號 465 時會自動使用 SSL
# MAIL_FROM=             # 寄件位址，預設與 MAIL_USER 相同

# 你的網站網址，信件連結與 npm run send-reminders 會用到
BASE_URL=https://your-project.vercel.app

# 選填
# SENDER_NAME=範例教會（請勿回覆）
# REMINDER_INTERVAL_SECONDS=30   # 催件腳本每封信的間隔秒數
# DRY_RUN=true                   # 催件腳本只列名單、不寄信

# ⚠️ 以下僅限「獨立的測試環境」，正式環境不要設定：
# ALLOW_TEST_BOOKS=1
# DISABLE_RATE_LIMIT=1
